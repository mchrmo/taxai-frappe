 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!doctype html>\r\n<html lang=\"sk\">\r\n\r\n\r\n\r\n<head>\r\n  <meta charset=\"utf-8\">\r\n  <title>Fakt\u00fara \u010d. {{doc.name}}</title>\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\r\n  <!-- Bootstrap 5.3 -->\r\n  <link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css\" rel=\"stylesheet\">\r\n  <link rel=\"icon\" type=\"image/x-icon\" href=\"https://www.noem.gold/wp-content/uploads/2023/05/cropped-fav2-32x32.jpg\">\r\n</head>\r\n\r\n<body class=\"bg-white\">\r\n  <div class=\"container py-4\">\r\n\r\n    <!-- Header -->\r\n    <div class=\"d-flex justify-content-between align-items-center mb-3\">\r\n      <div>\r\n        <h2 class=\"mb-1\">Fakt\u00fara {{doc.name}}</h2>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Parties -->\r\n    <div class=\"row g-3 mb-4\">\r\n      <div class=\"col-md-6\">\r\n        <div class=\"h-100\">\r\n          <div class=\"fw-semibold mb-2\">Dod\u00e1vate\u013e</div>\r\n          <div class=\"fw-bold\">Forez s.r.o.</div>\r\n          <div>Mado\u010dany 477</div>\r\n          <div>034 83 Liptovsk\u00e1 Tepl\u00e1</div>\r\n          <div class=\"mt-2\">\r\n            <div>I\u010cO: 12345678</div>\r\n            <div>DI\u010c: 1234567890</div>\r\n            <div>I\u010c DPH: SK1234567890</div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div class=\"col-md-6 text-end\">\r\n        <div class=\"h-100\">\r\n          <div class=\"fw-semibold mb-2\">Odberate\u013e</div>\r\n          <div class=\"fw-bold\">{{doc.customer}}</div>\r\n          <div>{{doc.customer_address_1}}</div>\r\n          <div>{{doc.customer_address_2}}</div>\r\n          <div class=\"mt-2\">\r\n            {%- if doc.customer_business_id -%}<div>I\u010cO: {{doc.customer_business_id}}</div>{% endif %}\r\n            {%- if doc.customer_tax_id -%}<div>DI\u010c: {{doc.customer_tax_id}}</div>{% endif %}\r\n            {%- if doc.customer_vat_id -%}<div>I\u010c DPH: {{doc.customer_vat_id}}</div>{% endif %}\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Dates -->\r\n    <div class=\"row mb-5\">\r\n      <div class=\"col\">\r\n        <div class=\"d-flex flex-wrap gap-4 justify-content-between\">\r\n          <div><span class=\"text-muted\">D\u00e1tum vystavenia:</span> <span class=\"fw-semibold\">{{frappe.format(doc.issued_date, {'fieldtype': 'Date'})}}</span></div>\r\n          <div><span class=\"text-muted\">D\u00e1tum dodania:</span> <span class=\"fw-semibold\">{{frappe.format(doc.delivery_date, {'fieldtype': 'Date'})}}</span></div>\r\n          <div><span class=\"text-muted\">D\u00e1tum splatnosti:</span> <span class=\"fw-semibold\">{{frappe.format(doc.due_date, {'fieldtype': 'Date'})}}</span></div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Intro note -->\r\n    <!-- <p class=\"mb-4\">\u010eakujeme za spolupr\u00e1cu.</p> -->\r\n\r\n    <!-- Items -->\r\n    <div class=\"table-responsive mb-4\">\r\n      <table class=\"table table-sm align-middle\">\r\n        <thead class=\"table-light\">\r\n          <tr>\r\n            <th class=\"text-start\">N\u00e1zov</th>\r\n            <th class=\"text-end\">Mno\u017estvo</th>\r\n            <th class=\"text-end\">Cena MJ</th>\r\n            <th class=\"text-end\">DPH %</th>\r\n            <th class=\"text-end\">Spolu bez DPH</th>\r\n            <th class=\"text-end\">Spolu s DPH</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n            {% for item in doc.items %}\r\n              <tr>\r\n                <td class=\"text-start\">\r\n                  <div class=\"fw-semibold\">{{item.item_name}}</div>\r\n                  {%- if item.description -%}<div class=\"small text-muted\">{{item.description}}</div>{% endif %}\r\n                </td>\r\n                <td class=\"text-end text-nowrap\">{{item.qty}}x</td>\r\n                <td class=\"text-end text-nowrap\">{{frappe.format(item.unit_price, {'fieldtype': 'Currency'})}}</td>\r\n                <td class=\"text-end text-nowrap\">{{frappe.format(item.vat_rate, {'fieldtype': 'Percentage'})}} %</td>\r\n                <td class=\"text-end text-nowrap\">{{frappe.format(item.total, {'fieldtype': 'Currency'})}}</td>\r\n                <td class=\"text-end text-nowrap\">{{frappe.format(item.total_with_vat, {'fieldtype': 'Currency'})}}</td>\r\n              </tr>\r\n            {% endfor %}\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n\r\n        <!-- Payment + Totals -->\r\n    <div class=\"d-flex\">\r\n      <div class=\"w-100\">\r\n        <div class=\"py-3\">\r\n          <div class=\"d-flex gap-2\">\r\n            <div class=\"fw-semibold\">Sp\u00f4sob \u00fahrady:</div>\r\n            <div class=\"\">{{doc.payment_method}}</div>\r\n          </div>\r\n          <div class=\"d-flex gap-2\">\r\n            <div class=\"fw-semibold\">IBAN:</div>\r\n            <div class=\"\">{{doc.iban}}</div>\r\n          </div>\r\n          <div class=\"d-flex gap-2\">\r\n            <div class=\"fw-semibold\">VS:</div>\r\n            <div class=\"\">000123</div>\r\n          </div>\r\n          <p class=\"small text-muted mb-0 mt-3\">Pros\u00edme, uve\u010fte variabiln\u00fd symbol pri platbe.</p>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"w-100\">\r\n        <div class=\"border rounded-3 p-3 h-100\">\r\n          <div class=\"fw-semibold mb-2\">Zhrnutie</div>\r\n          <div class=\"d-flex justify-content-between mb-2\">\r\n            <span>Z\u00e1klad dane</span>\r\n            <span class=\"fw-semibold\">{{frappe.format(doc.subtotal, {'fieldtype': 'Currency'})}}</span>\r\n          </div>\r\n          {% for tax in doc.taxes %}\r\n              <div class=\"d-flex justify-content-between mb-2\">\r\n                <span>DPH {{tax.rate}}%</span>\r\n                <span class=\"fw-semibold\">{{frappe.format(tax.vat, {'fieldtype': 'Currency'})}}</span>\r\n              </div>\r\n          {% endfor %}\r\n          <hr class=\"my-3\">\r\n          <div class=\"d-flex justify-content-between\">\r\n            <span class=\"fw-semibold\">Spolu</span>\r\n            <span class=\"fw-bold fs-5\">{{frappe.format(doc.total, {'fieldtype': 'Currency'})}}</span>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Footer note -->\r\n    <p class=\"text-end text-muted mt-4 mb-0 small\">Fakt\u00fara bola vytvoren\u00e1 elektronicky a je platn\u00e1 bez podpisu a\r\n      pe\u010diatky.</p>\r\n\r\n  </div>\r\n</body>\r\n\r\n</html>",
